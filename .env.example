# Supabase — leave unset for local in-memory/demo mode only.
# Production MUST set these; the app fails closed without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App metadata
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Used only by optional seed scripts — not read by the app at runtime.
SEED_DEMO_PASSWORD=

# Claude (server-only). Public assistant: claude-haiku-4-5; email/resume extraction: claude-sonnet-5-5.
ANTHROPIC_API_KEY=
# Salt for hashing visitor IPs in assistant/prefill rate limits (server-only).
ASSISTANT_RATE_LIMIT_SALT=

# Cloudflare Turnstile — bot protection for public endpoints that spend money
# (the contact form drafts a routing brief with Claude on every submission).
#
# BOTH must be set for enforcement to switch on. With either one missing the
# check is disabled end to end: no widget renders and no submission is ever
# rejected, so the endpoints behave exactly as they do with no Turnstile at all.
# Create the site at Cloudflare dashboard > Turnstile; the widget mode should be
# "Managed". Site key is public (it ships in the browser bundle); the secret key
# is server-only and must never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Scheduled jobs (Authorization: Bearer <CRON_SECRET>), same convention as functional-source.
CRON_SECRET=

# Email job intake: off (default) | mock (development only) | zoho
EMAIL_INTAKE_MODE=
# ISO date; mail received before this is never ingested.
EMAIL_INTAKE_INITIAL_SYNC_AFTER=
# Optional comma list of sender addresses and/or @domains.
EMAIL_INTAKE_ALLOWED_SENDERS=

# Zoho Mail OAuth (server-based client; server-only — never NEXT_PUBLIC_).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data-center specific, e.g. https://accounts.zoho.com and https://mail.zoho.com
ZOHO_ACCOUNTS_URL=
ZOHO_MAIL_API_URL=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FOLDER_ID=
